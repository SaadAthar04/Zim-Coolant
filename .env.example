# Copy to .env and fill in. .env is gitignored and must never be committed.

# Admin credentials.
# Server-side only: do NOT prefix these with NEXT_PUBLIC_, which would inline
# them into the JavaScript bundle served to every visitor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Signs the admin session cookie. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs all admins out.
ADMIN_SESSION_SECRET=

# Order emails.
# Gmail: SMTP_PASS must be a 16-character App Password from
# Google Account > Security > 2-Step Verification > App passwords.
# Leave blank to disable email; orders will still be placed and recorded.
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=meelanahmad321@gmail.com

# Optional, for a non-Gmail SMTP provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# Port (optional, defaults to 3000)
PORT=3000
