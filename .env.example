# Copy to .env and fill in. .env is gitignored and must never be committed.

# Admin credentials.
# Server-side only: do NOT prefix these with NEXT_PUBLIC_, which would inline
# them into the JavaScript bundle served to every visitor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Signs the admin session cookie. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs all admins out.
ADMIN_SESSION_SECRET=

# --- Email ------------------------------------------------------------------
#
# Hostinger mailbox settings. Port 465 with SMTP_SECURE=true is implicit TLS;
# port 587 with SMTP_SECURE=false is STARTTLS. Either works.
#
# There is ONE real mailbox (info@) with orders@ and contact@ as aliases onto
# it: same password, same inbox. So SMTP_USER is always the real mailbox — that
# is what the password authenticates — while the addresses below are aliases.
#
# Leave SMTP_USER/SMTP_PASS blank to disable email entirely: orders are still
# placed and recorded, and every attempted send is logged at /admin/emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@zimchemicals.com
SMTP_PASS=

# The name and address customers see in their inbox. An alias of SMTP_USER is
# fine as long as Hostinger allows this mailbox to send as it — the test button
# at /admin/emails will say so plainly if it does not. If it is refused, delete
# this line and mail goes out as SMTP_USER instead.
EMAIL_FROM="Zim Chemicals <orders@zimchemicals.com>"

# Where a customer's reply goes when they hit Reply.
EMAIL_REPLY_TO=info@zimchemicals.com

# Where new-order notifications, cancellations and low-stock alerts land.
# All three aliases share one inbox, so the distinction is only there to let
# you filter on the To: address inside that inbox.
ADMIN_EMAIL=orders@zimchemicals.com

# Where contact-page enquiries land. Kept separate at the client's request.
CONTACT_EMAIL=contact@zimchemicals.com

# Used to build absolute links and image URLs inside emails. Without it,
# product thumbnails break in every mail client.
NEXT_PUBLIC_SITE_URL=https://www.zimchemicals.com

# Signs the "Track my Order" links in order emails. Use a long random string
# (same generator as ADMIN_SESSION_SECRET above). Changing it invalidates the
# links in emails already sent; falls back to ADMIN_SESSION_SECRET if unset.
ORDER_LINK_SECRET=

# Deliverability: set SPF, DKIM and DMARC DNS records for zimchemicals.com in
# Hostinger, or order mail will be filed as spam.

# Port (optional, defaults to 3000)
PORT=3000
